{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/meta.schema.json",
  "title": "Certification metadata",
  "type": "object",
  "required": ["id", "name", "acronym", "syllabusVersion", "exam"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": {
      "type": "object",
      "required": ["tr", "en"],
      "additionalProperties": false,
      "properties": { "tr": { "type": "string" }, "en": { "type": "string" } }
    },
    "acronym": { "type": "string" },
    "stream": { "enum": ["core", "agile", "specialist"] },
    "level": { "enum": ["foundation", "advanced", "expert", "specialist"] },
    "syllabusVersion": { "type": "string" },
    "syllabusReleaseDate": { "type": "string", "format": "date" },
    "exam": {
      "type": "object",
      "required": ["questionCount", "totalPoints", "passPoints", "durationMinutes"],
      "additionalProperties": false,
      "properties": {
        "questionCount": { "type": "integer" },
        "totalPoints": { "type": "integer" },
        "passPoints": { "type": "integer" },
        "passPercent": { "type": "number" },
        "durationMinutes": { "type": "integer" },
        "pointsPerQuestion": { "type": "integer" },
        "negativeMarking": {
          "type": ["boolean", "null"],
          "description": "null = not stated in official documents. Do NOT write false — do not make an unverified claim."
        },
        "questionKLevelDistribution": { "type": "object" }
      }
    },
    "sources": { "type": "object" },
    "officialSampleExams": {
      "type": "array",
      "description": "Where the official sample exams live on the member board's own site. Links only — their copyright notice permits attributed excerpts for non-commercial use and prohibits every other use without ISTQB's written approval, so their questions are never reproduced here (docs/08 K-1, ADR-0004).",
      "items": {
        "type": "object",
        "required": ["set", "lang", "url", "publisher"],
        "additionalProperties": false,
        "properties": {
          "set": { "type": "string" },
          "lang": { "enum": ["tr", "en"] },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "documentVersion": { "type": "string" }
        }
      }
    }
  }
}
