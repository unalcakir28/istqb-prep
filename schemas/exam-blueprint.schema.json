{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/exam-blueprint.schema.json",
  "title": "Resmi sinav soru dagilimi (LO gruplari)",
  "type": "object",
  "required": ["syllabusVersion", "source", "groups"],
  "additionalProperties": false,
  "properties": {
    "syllabusVersion": { "type": "string" },
    "source": { "type": "string" },
    "rule": { "type": "string" },
    "status": {
      "type": "string",
      "description": "Opsiyonel ilerleme notu, orn. 'INCOMPLETE - F0-05 ile tamamlanacak'."
    },
    "totals": {
      "type": "object",
      "description": "Kendi-beyan ozet alani. Beklenen degerler burada SABITLENMEZ - CLAUDE.md geregi tek dogruluk kaynagi syllabus.json/meta.json'dur. CI check #9 bu alani degil, groups[] toplamini syllabus.json ile karsilastirir.",
      "required": ["questions", "byChapter", "byKLevel"],
      "additionalProperties": false,
      "properties": {
        "questions": { "type": "integer", "minimum": 1 },
        "byChapter": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byKLevel": {
          "type": "object",
          "required": ["K1", "K2", "K3"],
          "additionalProperties": false,
          "properties": {
            "K1": { "type": "integer", "minimum": 0 },
            "K2": { "type": "integer", "minimum": 0 },
            "K3": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapter", "kLevel", "questions", "objectives"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "chapter": { "type": "integer", "minimum": 1, "maximum": 6 },
          "kLevel": { "enum": ["K1", "K2", "K3"] },
          "questions": { "type": "integer", "minimum": 1 },
          "objectives": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^FL-[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        }
      }
    }
  }
}
