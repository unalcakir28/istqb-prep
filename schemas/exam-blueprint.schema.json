{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/exam-blueprint.schema.json",
  "title": "Official exam question distribution (LO groups)",
  "type": "object",
  "required": ["syllabusVersion", "source", "groups"],
  "additionalProperties": false,
  "properties": {
    "syllabusVersion": { "type": "string" },
    "source": { "type": "string" },
    "rule": { "type": "string" },
    "status": {
      "type": "string",
      "description": "Optional progress note, e.g. 'INCOMPLETE - to be completed with F0-05'."
    },
    "totals": {
      "type": "object",
      "description": "Self-reported summary field. Expected values are NOT hardcoded here — per CLAUDE.md, the single source of truth is syllabus.json/meta.json. CI check #9 compares the groups[] total against syllabus.json, not this field.",
      "required": ["questions", "byChapter", "byKLevel"],
      "additionalProperties": false,
      "properties": {
        "questions": { "type": "integer", "minimum": 1 },
        "byChapter": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byKLevel": {
          "type": "object",
          "required": ["K1", "K2", "K3"],
          "additionalProperties": false,
          "properties": {
            "K1": { "type": "integer", "minimum": 0 },
            "K2": { "type": "integer", "minimum": 0 },
            "K3": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapter", "kLevel", "questions", "objectives"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "chapter": { "type": "integer", "minimum": 1 },
          "kLevel": { "enum": ["K1", "K2", "K3"] },
          "questions": { "type": "integer", "minimum": 1 },
          "pointsPerQuestion": {
            "type": "integer",
            "minimum": 1,
            "description": "The tables' 'Suggested Points per Question' for this group. Absent = 1, which is every CTFL v4.0.1 group. Check #24 holds each question's points to it."
          },
          "objectives": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^(FL|AI)-[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        }
      }
    }
  }
}
