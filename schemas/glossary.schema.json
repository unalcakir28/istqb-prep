{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/glossary.schema.json",
  "title": "Terimler sozlugu parcasi",
  "type": "object",
  "required": ["terms"],
  "additionalProperties": false,
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "en", "tr", "source", "trSource"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "en": {
            "type": "object",
            "required": ["term", "definition"],
            "additionalProperties": false,
            "properties": {
              "term": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 }
            }
          },
          "tr": {
            "type": "object",
            "required": ["term", "definition"],
            "additionalProperties": false,
            "properties": {
              "term": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 }
            }
          },
          "usedIn": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["syllabus", "version"],
              "properties": {
                "syllabus": { "type": "string" },
                "version": { "type": "string" }
              }
            }
          },
          "source": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "trSource": {
            "enum": ["ttb-syllabus-v4.0.1", "ttb-glossary-v3.7", "editorial"],
            "description": "Turkce karsiligin kaynagi. Bkz. docs/07-icerik-uretim-rehberi.md §5 kaynak hiyerarsisi."
          }
        }
      }
    }
  }
}
