{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/glossary-index.schema.json",
  "title": "Glossary term index (for search)",
  "description": "data/<cert>/glossary/index.json. docs/04-data-model.md §3.9. Carries only each term's slug/tr/en/chunk, not its definitions.",
  "type": "object",
  "required": ["terms"],
  "additionalProperties": false,
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "tr", "en", "chunk"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "tr": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 },
          "chunk": { "type": "string", "pattern": "^terms-[a-z]$" }
        }
      }
    }
  }
}
