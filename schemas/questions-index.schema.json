{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istqb-prep/schemas/questions-index.schema.json",
  "title": "Sorular icin hafif indeks (soru metni yok)",
  "description": "data/<cert>/questions/index.json. docs/04-veri-modeli.md §3.6. CI check #8 bu dosyayi parca dosyalariyla karsilastirir.",
  "type": "object",
  "required": ["dataVersion", "count", "chunks", "questions"],
  "additionalProperties": false,
  "properties": {
    "dataVersion": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "chunks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ch[0-9]{2}-[a-z]$" }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "chunk", "chapter", "objectives", "kLevel", "type",
          "selectCount", "languages", "syllabusVersion", "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+-[0-9]{4}$" },
          "chunk": { "type": "string", "pattern": "^ch[0-9]{2}-[a-z]$" },
          "chapter": { "type": "integer", "minimum": 1, "maximum": 6 },
          "section": { "type": "string" },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^FL-[0-9]+\\.[0-9]+\\.[0-9]+$" }
          },
          "kLevel": { "enum": ["K1", "K2", "K3"] },
          "type": { "enum": ["single", "multi"] },
          "selectCount": { "type": "integer", "minimum": 1, "maximum": 3 },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "hasMedia": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "languages": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["tr", "en"] }
          },
          "syllabusVersion": { "type": "string" },
          "status": { "enum": ["draft", "review", "published", "retired"] }
        }
      }
    }
  }
}
