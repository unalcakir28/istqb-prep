      },
      "tr": {
        "term": "derin öğrenme"
      },
      "trSource": "ttb-ct-ai-v1.0",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/deep-learning"
    },
    {
      "slug": "deep-neural-network",
      "revision": 1,
      "en": {
        "term": "deep neural network",
        "definition": "A neural network comprised of several layers of neurons."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/deep-neural-network"
    },
    {
      "slug": "deepfake",
      "revision": 1,
      "en": {
        "term": "deepfake",
        "definition": "Synthetic media, such as video, audio, or images, created or edited using AI to convincingly mimic or impersonate real people or events."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/deepfake"
    },
    {
      "slug": "defect",
      "revision": 3,
      "en": {
        "term": "defect",
        "definition": "An imperfection or deficiency in a work product where it does not meet its requirements or specifications or impairs its intended use."
      },
      "tr": {
        "term": "hata"
      },
      "trSource": "ttb-syllabus-v4.0.1",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/defect"
    },
    {
      "slug": "defect-prediction",
      "revision": 1,
      "en": {
        "term": "defect prediction",
        "definition": "A technique to predict the areas within the test object in which defects will occur or the quantity of defects that are present"
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/defect-prediction"
    },
    {
      "slug": "deterministic",
      "revision": 1,
      "en": {
        "term": "deterministic",
        "definition": "Producing the same set of outputs and final state from a given set of inputs and starting state."
      },
      "tr": {
        "term": "deterministik"
      },
      "trSource": "ttb-ct-ai-v1.0",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/deterministic"
    },
    {
      "slug": "disparate-impact-analysis",
      "revision": 1,
      "en": {
        "term": "disparate impact analysis",
        "definition": "A technique for detecting bias by comparing decisions on original scenarios with their counterfactual versions, where sensitive attributes are swapped."
      },
      "tr": {
        "term": "orantısız etki analizi"
      },
      "trSource": "editorial",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/disparate-impact-analysis"
    },
    {
      "slug": "drift-testing",
      "revision": 1,
      "en": {
        "term": "drift testing",
        "definition": "A type of maintenance testing that evaluates the degree to which data drift, concept drift or both occur."
      },
      "tr": {
        "term": "kayma testi"
      },
      "trSource": "editorial",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/drift-testing"
    },
    {
      "slug": "driver",
      "revision": 2,
      "en": {
        "term": "driver",
        "definition": "A component or tool that temporarily replaces another component and controls or calls a test item in isolation."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/driver"
    },
    {
      "slug": "dynamic-testing",
      "revision": 2,
      "en": {
        "term": "dynamic testing",
        "definition": "A test approach that involves test execution of a test item."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/dynamic-testing"
    }
  ]
}
