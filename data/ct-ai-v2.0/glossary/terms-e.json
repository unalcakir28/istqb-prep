      "revision": 1,
      "en": {
        "term": "edge AI",
        "definition": "The deployment of AI models on local edge devices, enabling real-time processing near the source of data without relying on cloud-based systems."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/edge-ai"
    },
    {
