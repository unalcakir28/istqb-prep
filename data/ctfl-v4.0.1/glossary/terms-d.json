    },
    {
      "slug": "defect-density",
      "revision": 2,
      "en": {
        "term": "defect density",
        "definition": "The number of defects per unit size of a work product."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/defect-density"
    },
    {
      "slug": "defect-detection-percentage",
      "revision": 1,
      "en": {
        "term": "defect detection percentage",
        "definition": "The number of defects found by a test level, divided by the number found by that test level and any other means afterwards."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/defect-detection-percentage"
    },
