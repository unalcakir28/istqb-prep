      },
      "trSource": "ttb-syllabus-v4.0.1",
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/coverage"
    },
    {
      "slug": "coverage-criteria",
      "revision": 1,
      "en": {
        "term": "coverage criteria",
        "definition": "The criteria to define the coverage items required to reach a test objective."
      },
      "source": "ISTQB Glossary",
      "sourceUrl": "https://glossary.istqb.org/en_US/term/coverage-criteria"
    },
    {
